[mysqld]
# General query logging
general_log = 0                      # Always OFF in production

# Slow query logging
slow_query_log = 1                   # ON for monitoring
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2                  # Log queries slower than 2s
log_queries_not_using_indexes = 0    # OFF (avoid overhead in production)

# Error logging
log_error = /var/lib/mysql/error.log
log_error_verbosity = 2              # Errors + warnings

# Binary logging (replication / PITR)
log_bin = /var/lib/mysql/mysql-bin
binlog_expire_logs_seconds = 1209600 # 14 days retention (safer for backups)
max_binlog_size = 100M               # Limit binlog file size